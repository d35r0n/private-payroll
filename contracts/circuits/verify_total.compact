/**
 * Step 4 — verify_total circuit/view
 *
 * View circuit verifying that the round sum check has been proven and is valid
 * against stored commitments and the public budget.
 *
 * Privacy Guarantee:
 *   - Does not take, expose, or require any individual recipient amount.
 *   - Public output: boolean verification status.
 */

pragma language_version 0.23;

import CompactStandardLibrary;

export circuit verify_total(
  is_finalized: Boolean,
  sum_valid: Boolean
): Boolean {
  // Re-verify that the payroll round has reached Finalized status with a valid proof
  return is_finalized && sum_valid;
}
